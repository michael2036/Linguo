{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Linguo grammar cards",
  "description": "One-screen grammar review cards (public/data/grammar/cards.json). Length limits keep every card readable on a phone without scrolling the front.",
  "type": "object",
  "required": ["cards"],
  "additionalProperties": false,
  "properties": {
    "cards": { "type": "array", "items": { "$ref": "#/definitions/card" } }
  },
  "definitions": {
    "marked": { "type": "string", "minLength": 1 },
    "column": {
      "type": "object",
      "required": ["label", "tone", "items"],
      "additionalProperties": false,
      "properties": {
        "label": { "type": "string", "maxLength": 24 },
        "sublabel": { "type": "string", "maxLength": 28 },
        "tone": { "enum": ["accent", "success", "neutral"] },
        "lines": { "type": "boolean" },
        "inline": { "type": "boolean" },
        "items": { "type": "array", "minItems": 1, "maxItems": 7, "items": { "$ref": "#/definitions/marked" } }
      }
    },
    "card": {
      "type": "object",
      "required": ["id", "level", "category", "title", "subtitle", "lektionIds", "visual", "examples", "warning", "back"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^(a1|a2|b1)-[a-z0-9-]+$" },
        "level": { "enum": ["A1", "A2", "B1"] },
        "category": { "enum": ["satzbau", "verben", "nomen", "praepositionen", "adjektive", "konnektoren", "redemittel"] },
        "title": { "type": "string", "maxLength": 40 },
        "subtitle": { "type": "string", "maxLength": 70 },
        "lektionIds": { "type": "array", "items": { "type": "string", "pattern": "^(a1|a2|b1)-m[1-8]-l[0-9]+$" } },
        "visual": {
          "oneOf": [
            {
              "type": "object",
              "required": ["kind", "columns"],
              "additionalProperties": false,
              "properties": {
                "kind": { "const": "columns" },
                "columns": { "type": "array", "minItems": 1, "maxItems": 2, "items": { "$ref": "#/definitions/column" } }
              }
            },
            {
              "type": "object",
              "required": ["kind", "headers", "rows"],
              "additionalProperties": false,
              "properties": {
                "kind": { "const": "table" },
                "headers": { "type": "array", "minItems": 2, "maxItems": 3, "items": { "type": "string" } },
                "rows": {
                  "type": "array",
                  "minItems": 2,
                  "maxItems": 5,
                  "items": { "type": "array", "minItems": 2, "maxItems": 3, "items": { "$ref": "#/definitions/marked" } }
                },
                "highlightColumn": { "type": "integer", "minimum": 0, "maximum": 2 }
              }
            }
          ]
        },
        "tip": { "type": "string", "maxLength": 80 },
        "examples": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "items": {
            "type": "object",
            "required": ["text"],
            "additionalProperties": false,
            "properties": {
              "text": { "type": "string", "maxLength": 60 },
              "result": { "type": "string", "maxLength": 60 }
            }
          }
        },
        "warning": {
          "type": "object",
          "required": ["wrong", "right", "note"],
          "additionalProperties": false,
          "properties": {
            "wrong": { "type": "string", "maxLength": 50 },
            "right": { "type": "string", "maxLength": 50 },
            "note": { "type": "string", "maxLength": 60 }
          }
        },
        "back": {
          "type": "object",
          "required": ["sections", "check"],
          "additionalProperties": false,
          "properties": {
            "sections": {
              "type": "array",
              "maxItems": 3,
              "items": {
                "type": "object",
                "required": ["title", "lines"],
                "additionalProperties": false,
                "properties": {
                  "title": { "type": "string", "maxLength": 30 },
                  "lines": { "type": "array", "minItems": 1, "maxItems": 6, "items": { "$ref": "#/definitions/marked" } }
                }
              }
            },
            "check": {
              "type": "array",
              "minItems": 2,
              "maxItems": 3,
              "items": {
                "type": "object",
                "required": ["prompt", "answer"],
                "additionalProperties": false,
                "properties": {
                  "prompt": { "type": "string" },
                  "answer": { "type": "string" }
                }
              }
            }
          }
        }
      }
    }
  }
}
