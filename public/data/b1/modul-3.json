          { "id": "l7m02", "type": "sentence-scramble", "instruction": "Bilde eine indirekte Frage.", "prompt": "Baue den Satz aus den Wörtern.", "scrambleChunks": ["Ich", "frage", "mich,", "ob", "das", "stimmt"], "solution": "Ich frage mich, ob das stimmt.", "hint": "Verb am Ende des ob-Satzes.", "explanation": "Im ob-Satz steht das Verb am Ende." },
