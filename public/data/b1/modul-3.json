          { "id": "l7m10", "type": "cloze-conjugation", "instruction": "Konjugiere das Verb in Klammern.", "prompt": "Er ___ (anbieten) mir eine Übernachtung.", "solution": "bietet", "hint": "Trennbares Verb, 3. Person Singular.", "explanation": "Die 'er'-Form von 'anbieten' lautet 'bietet ... an'." }
