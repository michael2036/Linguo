        { "id": "l7v02", "term": "kennenlernen", "translation": "conocer", "partOfSpeech": "verb", "preterite": "lernte kennen", "participle": "kennengelernt", "auxiliary": "haben", "irregular": false, "example": "Sie hat viele Menschen kennengelernt." },
