          { "id": "l7e05", "type": "multiple-choice", "instruction": "Wähle das passende Wort.", "prompt": "Sie hat im ___ geschlafen.", "options": ["Zelt", "Spiegel", "Erlebnis", "Alleinsein"], "solution": "Zelt", "hint": "Ein Ort zum Übernachten im Freien.", "explanation": "'Zelt' ist ein Ort zum Übernachten im Freien." },
