          { "id": "l7e01", "type": "multiple-choice", "instruction": "Wähle das richtige Fragewort.", "prompt": "Ich weiß nicht, ___ sie übernachtet hat.", "options": ["wo", "ob", "was", "wer"], "solution": "wo", "hint": "Fragt nach dem Ort.", "explanation": "'wo' fragt nach dem Ort." },
          { "id": "l7e02", "type": "multiple-choice", "instruction": "Wähle das richtige Fragewort.", "prompt": "Ich frage mich, ___ das stimmt.", "options": ["ob", "wo", "was", "wer"], "solution": "ob", "hint": "Leitet eine Ja/Nein-Frage ein.", "explanation": "'ob' leitet eine indirekte Ja/Nein-Frage ein." },
          { "id": "l7e03", "type": "multiple-choice", "instruction": "Wähle das richtige Fragewort.", "prompt": "Ich weiß nicht, ___ sie gemacht hat.", "options": ["was", "ob", "wo", "wer"], "solution": "was", "hint": "Fragt nach einer Sache.", "explanation": "'was' fragt nach einer Sache." },
