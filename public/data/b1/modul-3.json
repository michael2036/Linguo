          { "id": "l7e08", "type": "fill-in-blank", "instruction": "Ergänze das Adverb.", "prompt": "___ ging es ihr gut. (insgesamt)", "solution": "Insgesamt", "hint": "Zusammenfassend.", "explanation": "'Insgesamt' fasst eine Erfahrung zusammen." },
          { "id": "l7e09", "type": "fill-in-blank", "instruction": "Ergänze das Nomen.", "prompt": "Das war ein besonderes ___. (Erlebnis)", "solution": "Erlebnis", "hint": "Ein Substantiv.", "explanation": "'Erlebnis' ist das gesuchte Substantiv." },
