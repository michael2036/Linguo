          { "id": "l7m07", "type": "cloze-conjugation", "instruction": "Konjugiere das Verb in Klammern.", "prompt": "Ich weiß nicht, ob sie ___ (haben) Probleme mit dem Alleinsein.", "solution": "hat", "hint": "3. Person Singular.", "explanation": "Die 'sie'-Form von 'haben' lautet 'hat'." },
          { "id": "l7m08", "type": "cloze-conjugation", "instruction": "Konjugiere das Verb in Klammern.", "prompt": "Ich frage mich, was sie dort ___ (machen).", "solution": "macht", "hint": "3. Person Singular.", "explanation": "Die 'sie'-Form von 'machen' lautet 'macht'." },
